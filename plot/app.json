{
  "expo": {
    "name": "PLOT",
    "slug": "plot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "plot",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.plot.demo",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.plot.demo",
      "adaptiveIcon": {
        "backgroundColor": "#E0070F",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E0070F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PLOT usa tus fotos para que puedas publicarlas en tu perfil o enviarlas en un chat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false,
      "baseUrl": "/plot_date_app"
    }
  }
}
